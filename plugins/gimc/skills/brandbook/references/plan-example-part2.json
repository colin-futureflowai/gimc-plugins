   "html": "<!DOCTYPE html><html lang=\"nl\"><head><meta charset=\"utf-8\"><title>TEST-Studio Noord — Beeldtaal</title></head><body><main class=\"page\"><header class=\"masthead\"><span class=\"label\"><b>TEST-Studio Noord</b> — Designsysteem</span><span class=\"label\">05 — Beeldtaal</span><span class=\"label\">v1.0 · nov 2026</span></header><section class=\"intro\"><p class=\"num\">05</p><div class=\"what\"><h1 class=\"title\">Beeldtaal</h1><p class=\"lede\">Daglicht, echte materialen en handen aan het werk. Rustige beelden met ruimte, nooit geposeerd. <span class=\"tag\">voorstel</span></p></div></section><section class=\"sect\"><div class=\"sect-head\"><span class=\"label\">Fotografie</span><span class=\"label\">Unsplash · voorbeeldkeuze</span></div><div class=\"mosaic\"><figure class=\"m-big\"><div class=\"photo\"><img class=\"\" src=\"https://images.unsplash.com/photo-1503387762-592deb58ef4e?w=1400&q=80&auto=format&fit=crop\" alt=\"Handen schetsen een plattegrond op calqueerpapier\"></div><figcaption class=\"cap\"><span class=\"label\"><b>01</b> — Handwerk zichtbaar: schetsen op papier</span></figcaption></figure><div class=\"m-side\"><figure class=\"\"><div class=\"photo\"><img class=\"\" src=\"https://images.unsplash.com/photo-1561070791-2526d30994b5?w=1400&q=80&auto=format&fit=crop\" alt=\"Kleurstalen en papiermonsters op een bureau\"></div><figcaption class=\"cap\"><span class=\"label\"><b>02</b> — Materiaal en kleur</span></figcaption></figure><figure class=\"\"><div class=\"photo\"><img class=\"\" src=\"https://images.unsplash.com/photo-1586717791821-3f44a563fa4c?w=1400&q=80&auto=format&fit=crop\" alt=\"Een wireframe wordt op een tablet geschetst\"></div><figcaption class=\"cap\"><span class=\"label\"><b>03</b> — Het ontwerp in wording</span></figcaption></figure></div><figure class=\"m-third\"><div class=\"photo\"><img class=\"\" src=\"https://images.unsplash.com/photo-1524758631624-e2822e304c36?w=1400&q=80&auto=format&fit=crop\" alt=\"Licht interieur met lamp, stoelen en houten kasten\"></div><figcaption class=\"cap\"><span class=\"label\"><b>04</b> — Daglicht, ruimte, hout</span></figcaption></figure><figure class=\"m-third\"><div class=\"photo\"><img class=\"\" src=\"https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=1400&q=80&auto=format&fit=crop\" alt=\"Wit gebouw met schuine vlakken tegen een lichte lucht\"></div><figcaption class=\"cap\"><span class=\"label\"><b>05</b> — Heldere vormen</span></figcaption></figure><figure class=\"m-third\"><div class=\"photo\"><img class=\"\" src=\"https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=1400&q=80&auto=format&fit=crop\" alt=\"Gele fauteuil in een rustige witte kamer\"></div><figcaption class=\"cap\"><span class=\"label\"><b>06</b> — Eén kleuraccent per beeld</span></figcaption></figure></div></section><section class=\"sect\"><div class=\"sect-head\"><span class=\"label\">Principes</span><span class=\"label\"></span></div><ol class=\"rules\"><li><span class=\"label\">01</span><p class=\"h3\">Daglicht</p><p class=\"small muted\">Natuurlijk licht, zachte schaduwen. Geen flits, geen filters.</p></li><li><span class=\"label\">02</span><p class=\"h3\">Echt werk</p><p class=\"small muted\">Handen, schetsen, materiaal. Het proces mag je zien.</p></li><li><span class=\"label\">03</span><p class=\"h3\">Ruimte</p><p class=\"small muted\">Eén onderwerp per beeld, met lucht eromheen voor tekst.</p></li><li><span class=\"label\">04</span><p class=\"h3\">Eén accent</p><p class=\"small muted\">Hoogstens één felle kleur in beeld, liefst in de buurt van zeegroen of klei.</p></li></ol></section><section class=\"sect\"><div class=\"sect-head\"><span class=\"label\">Zo wel, zo niet</span><span class=\"label\"></span></div><div class=\"dd\"><figure><div class=\"photo\"><img class=\"\" src=\"https://images.unsplash.com/photo-1586717791821-3f44a563fa4c?w=1000&q=80&auto=format&fit=crop\" alt=\"Een wireframe wordt op een tablet geschetst\"></div><figcaption class=\"cap label\"><span class=\"wel\">Wel</span> — echte handen aan echt werk, rustige compositie</figcaption></figure><figure><div class=\"photo\"><img class=\"\" src=\"https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=1000&q=80&auto=format&fit=crop\" alt=\"Twee mensen geven elkaar een high five aan een bureau\"></div><figcaption class=\"cap label\"><span class=\"niet\">Niet</span> — geposeerde stockfoto, gespeeld enthousiasme</figcaption></figure></div></section><footer class=\"foot\"><span class=\"label\">TEST-Studio Noord · Designsysteem v1.0 · nov 2026</span><span class=\"label\">05 / 08</span></footer></main></body></html>",
